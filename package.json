  "main": "index.js",
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./static/css/input.css -o ./static/css/output.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./static/css/input.css -o ./static/css/output.css --minify",
    "build:js": "esbuild static/js/dashboard.js --bundle --minify --outfile=static/js/dashboard.bundle.js",
    "build:architect-js": "esbuild static/js/architect-dashboard.js --bundle --minify --outfile=static/js/architect-dashboard.bundle.js",
    "build:assistant-js": "esbuild static/js/assistant-dashboard.js --bundle --minify --outfile=static/js/assistant-dashboard.bundle.js",
    "build": "npm run build:css && npm run build:js && npm run build:architect-js && npm run build:assistant-js"
  },
  "repository": {
    "type": "git",
